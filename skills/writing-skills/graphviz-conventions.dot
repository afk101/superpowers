digraph STYLE_GUIDE {
    // 我们流程 DSL 的样式指南，使用 DSL 本身编写

    // 节点类型示例及其形状
    subgraph cluster_node_types {
        label="节点类型和形状";

        // 问题使用菱形
        "这是一个问题吗？" [shape=diamond];

        // 操作使用矩形（默认）
        "执行操作" [shape=box];

        // 命令使用纯文本
        "git commit -m 'msg'" [shape=plaintext];

        // 状态使用椭圆
        "当前状态" [shape=ellipse];

        // 警告使用八边形
        "停止：严重警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 入口/出口使用双圆
        "流程开始" [shape=doublecircle];
        "流程完成" [shape=doublecircle];

        // 每种类型的示例
        "测试通过吗？" [shape=diamond];
        "先编写测试" [shape=box];
        "npm test" [shape=plaintext];
        "我卡住了" [shape=ellipse];
        "绝不使用 git add -A" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 边命名约定
    subgraph cluster_edge_types {
        label="边标签";

        "二元决策？" [shape=diamond];
        "是路径" [shape=box];
        "否路径" [shape=box];

        "二元决策？" -> "是路径" [label="yes"];
        "二元决策？" -> "否路径" [label="no"];

        "多选题？" [shape=diamond];
        "选项 A" [shape=box];
        "选项 B" [shape=box];
        "选项 C" [shape=box];

        "多选题？" -> "选项 A" [label="条件 A"];
        "多选题？" -> "选项 B" [label="条件 B"];
        "多选题？" -> "选项 C" [label="否则"];

        "流程 A 完成" [shape=doublecircle];
        "流程 B 开始" [shape=doublecircle];

        "流程 A 完成" -> "流程 B 开始" [label="触发", style=dotted];
    }

    // 命名模式
    subgraph cluster_naming_patterns {
        label="命名模式";

        // 问题以 ? 结尾
        "我应该做 X 吗？";
        "这可以是 Y 吗？";
        "Z 是真的吗？";
        "我完成 W 了吗？";

        // 操作以动词开头
        "编写测试";
        "搜索模式";
        "提交更改";
        "寻求帮助";

        // 命令是字面量
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状态描述情况
        "测试失败";
        "构建完成";
        "遇到错误";
    }

    // 流程结构模板
    subgraph cluster_structure {
        label="流程结构模板";

        "触发器：某事发生" [shape=ellipse];
        "初始检查？" [shape=diamond];
        "主要操作" [shape=box];
        "git status" [shape=plaintext];
        "另一个检查？" [shape=diamond];
        "替代操作" [shape=box];
        "停止：不要这样做" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "流程完成" [shape=doublecircle];

        "触发器：某事发生" -> "初始检查？";
        "初始检查？" -> "主要操作" [label="yes"];
        "初始检查？" -> "替代操作" [label="no"];
        "主要操作" -> "git status";
        "git status" -> "另一个检查？";
        "另一个检查？" -> "流程完成" [label="ok"];
        "另一个检查？" -> "停止：不要这样做" [label="problem"];
        "替代操作" -> "流程完成";
    }

    // 何时使用哪种形状
    subgraph cluster_shape_rules {
        label="何时使用每种形状";

        "选择形状" [shape=ellipse];

        "是决策吗？" [shape=diamond];
        "使用菱形" [shape=diamond, style=filled, fillcolor=lightblue];

        "是命令吗？" [shape=diamond];
        "使用纯文本" [shape=plaintext, style=filled, fillcolor=lightgray];

        "是警告吗？" [shape=diamond];
        "使用八边形" [shape=octagon, style=filled, fillcolor=pink];

        "是入口/出口吗？" [shape=diamond];
        "使用双圆" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "是状态吗？" [shape=diamond];
        "使用椭圆" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "默认：使用矩形" [shape=box, style=filled, fillcolor=lightcyan];

        "选择形状" -> "是决策吗？";
        "是决策吗？" -> "使用菱形" [label="yes"];
        "是决策吗？" -> "是命令吗？" [label="no"];
        "是命令吗？" -> "使用纯文本" [label="yes"];
        "是命令吗？" -> "是警告吗？" [label="no"];
        "是警告吗？" -> "使用八边形" [label="yes"];
        "是警告吗？" -> "是入口/出口吗？" [label="no"];
        "是入口/出口吗？" -> "使用双圆" [label="yes"];
        "是入口/出口吗？" -> "是状态吗？" [label="no"];
        "是状态吗？" -> "使用椭圆" [label="yes"];
        "是状态吗？" -> "默认：使用矩形" [label="no"];
    }

    // 好与坏的示例
    subgraph cluster_examples {
        label="好与坏的示例";

        // 好：具体且形状正确
        "测试失败" [shape=ellipse];
        "读取错误信息" [shape=box];
        "能复现吗？" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "绝不要忽略错误" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "测试失败" -> "读取错误信息";
        "读取错误信息" -> "能复现吗？";
        "能复现吗？" -> "git diff HEAD~1" [label="yes"];

        // 坏：模糊且形状错误
        bad_1 [label="出问题了", shape=box];  // 应该是椭圆（状态）
        bad_2 [label="修复它", shape=box];  // 太模糊
        bad_3 [label="检查", shape=box];  // 应该是菱形
        bad_4 [label="运行命令", shape=box];  // 应该是纯文本并包含实际命令

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}